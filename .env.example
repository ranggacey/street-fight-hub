# Street Fight Tournament Hub — contoh env (JANGAN isi nilai asli di sini)
# Salin ke .env.local dan isi dengan nilai sebenarnya. .env.local TIDAK di-commit.

# MongoDB Atlas connection string (database "street-fight-hub")
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority


# JWT secret — string acak panjang (min 32 karakter), untuk menandatangani sesi
JWT_SECRET=isi-dengan-string-acak-panjang-min-32-karakter

# Slug rahasia admin dashboard, mis. arena-control-xxx (tanpa slash di depan)
ADMIN_SLUG=arena-control-xxxx

# Akun admin awal (dibuat oleh `npm run seed`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=isi-password-kuat-di-sini
